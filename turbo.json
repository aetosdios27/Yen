{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json", "biome.json", "vitest.config.ts", ".nvmrc"],
  "globalPassThroughEnv": [
    "YEN_TEST_DATABASE_URL",
    "YEN_ANVIL_TEST_DATABASE_URL",
    "CI",
    "DATABASE_URL",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NEXT_PUBLIC_API_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@yen/web#typecheck": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["YEN_TEST_DATABASE_URL", "YEN_ANVIL_TEST_DATABASE_URL", "CI"]
    },
    "@yen/api-client#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/openapi/openapi.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
