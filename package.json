{
  "name": "yen",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:full": "tsx scripts/dev-full.ts",
    "db:migrate": "pnpm --filter @yen/db migrate",
    "privacy:erase-contact": "tsx packages/db/src/privacy-contact-cli.ts",
    "pilot:metrics": "tsx scripts/pilot-metrics.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "check": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:load": "pnpm --filter @yen/load-tests test:load",
    "build": "turbo run build",
    "repro:build": "bash scripts/repro-build.sh",
    "verify": "pnpm check && turbo run typecheck test build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "@yen/db": "workspace:*",
    "@yen/shared": "workspace:*",
    "tsx": "4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
