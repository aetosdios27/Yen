#!/usr/bin/env node
import { createHash } from "node:crypto";
import { readFile } from "node:fs/promises";

const [archive, checksums, attestation] = process.argv.slice(2);
if (!archive || !checksums || !attestation) {
  console.error(
    "Usage: node scripts/verify-release <archive> <SHA256SUMS> <attestation-input>",
  );
  process.exit(2);
}
// Local rehearsal checks a supplied in-toto subject digest, but cannot validate
// its signature or GitHub identity. That remains `gh attestation verify`.
const data = await readFile(archive);
const expectedLine = (await readFile(checksums, "utf8"))
  .split(/\r?\n/)
  .find((line) => line.endsWith(`  ${archive.split("/").at(-1)}`));
if (!expectedLine) {
  console.error(`RELEASE_VERIFY_CHECKSUM_MISSING: no checksum for ${archive}`);
  process.exit(1);
}
const expected = expectedLine.slice(0, 64);
const actual = createHash("sha256").update(data).digest("hex");
if (!/^[a-f0-9]{64}$/.test(expected) || actual !== expected) {
  console.error(`RELEASE_VERIFY_DIGEST_MISMATCH: ${archive}`);
  process.exit(1);
}
if (attestation !== "local-rehearsal") {
  let statements;
  try {
    statements = (await readFile(attestation, "utf8"))
      .trim()
      .split(/\r?\n/)
      .map((line) => JSON.parse(line));
  } catch {
    console.error(`RELEASE_VERIFY_ATTESTATION_INVALID: ${attestation}`);
    process.exit(1);
  }
  const digestMatches = statements.some((statement) =>
    statement.subject?.some((subject) => subject.digest?.sha256 === actual),
  );
  if (!digestMatches) {
    console.error(`RELEASE_VERIFY_ATTESTATION_DIGEST_MISMATCH: ${attestation}`);
    process.exit(1);
  }
}
console.log(`RELEASE_VERIFY_OK: ${archive}`);
