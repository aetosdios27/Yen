{
  "name": "@yen/load-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:load": "node --import=tsx src/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@yen/api": "workspace:*",
    "@yen/db": "workspace:*",
    "@yen/policy": "workspace:*",
    "@yen/shared": "workspace:*",
    "autocannon": "^8.0.0",
    "hono": "4.13.14",
    "postgres": "^3.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^26.6.5",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
