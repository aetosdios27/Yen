{
  "name": "@yen/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "node src/cli.ts",
    "verify-chain": "node src/verify-cli.ts",
    "export-audit-bundle": "node src/export-audit-cli.ts",
    "check:fk-indexes": "node src/check-fk-indexes-cli.ts",
    "retention": "node src/retention-cli.ts"
  },
  "dependencies": {
    "@yen/eventlog": "workspace:*",
    "@yen/shared": "workspace:*",
    "postgres": "^3.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
