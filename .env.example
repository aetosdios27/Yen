# ==============================================================================
# Yen Local Development Environment Configuration
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Application primary database connection URL
DATABASE_URL=postgres://postgres:pw@localhost:5432/postgres
# Optional OTLP HTTP base endpoint. Telemetry export remains disabled when unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
EVIDENCE_STORAGE_DIR=./.data/evidence

# Test runner admin connection URL (used by vitest database suites)
YEN_TEST_DATABASE_URL=postgres://postgres:pw@localhost:5432/postgres

# Docker compose database service credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pw
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis Cache & Pub/Sub
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# API Service (@yen/api - Hono on Node.js)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
YEN_ALLOW_MEMORY_STORES=false
READINESS_CACHE_MS=1000
TRUSTED_PROXY_HOPS=0
# Shared secret (32+ chars) for partner webhook signatures. Leave commented out to reject every webhook; an empty value fails startup.
# PARTNER_WEBHOOK_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_NAME=Yen

# Rate Limiting Configuration
WAITLIST_MIN_RESPONSE_MS=75
WAITLIST_RATE_LIMIT_CAPACITY=5
WAITLIST_RATE_LIMIT_REFILL_MS=3600000
WAITLIST_BODY_LIMIT_BYTES=8192
RATE_LIMIT_MAX_KEYS=100000
RATE_LIMIT_IP_CAPACITY=120
RATE_LIMIT_PRINCIPAL_CAPACITY=60
RATE_LIMIT_REFILL_MS=60000

# ------------------------------------------------------------------------------
# Background Queue Worker (@yen/queue - pg-boss)
# ------------------------------------------------------------------------------
QUEUE_SCHEMA=pgboss
QUEUE_MIGRATE=true

# ------------------------------------------------------------------------------
# Web Frontend (@yen/web - Next.js 16)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Smart Contracts & On-Chain Anchoring (Polygon Amoy Testnet)
# ------------------------------------------------------------------------------
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
ROOT_REGISTRY_PUBLISHER=
ETHERSCAN_API_KEY=

# ----------------------------------------------------------------------------
# Delivery adapters: local development defaults to the in-memory stub.
# Production requires DELIVERY_PROVIDER=external and all provider/webhook values.
# Store credentials in your deployment secret manager; never commit them.
# ----------------------------------------------------------------------------
DELIVERY_PROVIDER=stub
# WHATSAPP_API_BASE_URL=
# WHATSAPP_API_VERSION=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEMPLATES_JSON=JSON map: logical template -> name/language/parameters; OTP needs code
# EXOTEL_SMS_ENDPOINT=
# EXOTEL_SMS_STATUS_CALLBACK_URL= # HTTPS relay endpoint that signs Exotel callbacks for Yen
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_SENDER_ID=
# EXOTEL_DLT_ENTITY_ID=
# EXOTEL_SMS_TEMPLATES_JSON=logical template -> per-locale DLT IDs; OTP also needs approved en/hi body templates with {{code}}
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# EXOTEL_RELAY_WEBHOOK_SECRET=
