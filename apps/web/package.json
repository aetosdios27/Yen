{
  "name": "@yen/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:a11y": "vitest run a11y",
    "e2e": "playwright test",
    "e2e:real": "playwright test -c playwright.real.config.ts",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@scritto/react": "^0.1.0",
    "@yen/api-client": "workspace:*",
    "@yen/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.5",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vitest-axe": "0.1.0"
  }
