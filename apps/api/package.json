{
  "name": "@yen/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm openapi:check && vitest run",
    "test:load": "tsx scripts/load-test.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "openapi:generate": "pnpm --filter @yen/shared build && tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "dev:mock": "pnpm --filter @yen/shared build && PORT=${PORT:-3001} tsx --env-file-if-exists=.env src/mock-server.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@yen/db": "workspace:*",
    "@yen/ledger": "workspace:*",
    "@yen/policy": "workspace:*",
    "@yen/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  }
}
