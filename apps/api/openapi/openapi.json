{
  "openapi": "3.1.0",
  "info": {
    "title": "Yen API",
    "version": "1.0.0",
    "description": "YEN-15 foundation contract. Funds are explicit in-memory stubs. Paise uses decimal strings."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Reserved for YEN-22. Only injected principals authenticate today."
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "validation_failed",
                  "unauthenticated",
                  "forbidden",
                  "not_found",
                  "conflict",
                  "idempotency_conflict",
                  "rate_limited",
                  "overloaded",
                  "payload_too_large",
                  "internal",
                  "gateway_timeout"
                ]
              },
              "message": { "type": "string" },
              "requestId": { "type": "string", "format": "uuid" },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "array",
                      "items": { "anyOf": [{ "type": "string" }, { "type": "number" }] }
                    },
                    "message": { "type": "string" }
                  },
                  "required": ["path", "message"]
                }
              }
            },
            "required": ["code", "message", "requestId"]
          }
        },
        "required": ["error"]
      },
      "WaitlistInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "contact": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "pattern": "(?:^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$)|(?:^\\+[1-9][0-9]{7,14}$)|(?:^(?=.{10,19}$)[6-9](?:[ -]*[0-9]){9}[ -]*$)",
            "description": "Email address, international phone in + digits form, or Indian 10-digit mobile number with optional spaces or hyphens."
          },
          "org": { "type": "string", "minLength": 1, "maxLength": 200 },
          "locale": { "type": "string", "enum": ["en", "hi"] },
          "consent": {
            "type": "object",
            "properties": {
              "accepted": { "type": "boolean", "enum": [true] },
              "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "version": { "type": "string", "minLength": 1, "maxLength": 40 }
            },
            "required": ["accepted", "text", "version"],
            "additionalProperties": false
          }
        },
        "required": ["name", "contact", "org", "locale", "consent"],
        "additionalProperties": false
      },
      "Principal": {
        "type": "object",
        "properties": { "id": { "type": "string", "format": "uuid" } },
        "required": ["id"]
      },
      "Fund": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "targetPaise": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Nonnegative integer paise as a canonical decimal string; never a JSON number."
          },
          "id": { "type": "string", "format": "uuid" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["name", "targetPaise", "id", "createdAt"],
        "additionalProperties": false
      },
      "CreateFund": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "targetPaise": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Nonnegative integer paise as a canonical decimal string; never a JSON number."
          }
        },
        "required": ["name", "targetPaise"],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/waitlist": {
      "post": {
        "operationId": "joinWaitlist",
        "tags": ["waitlist"],
        "requestBody": {
          "required": true,
