            "application/json": { "schema": { "$ref": "#/components/schemas/WaitlistInput" } }
          }
        },
        "responses": {
          "201": {
            "description": "Submission received",
            "headers": {
              "x-request-id": {
                "schema": { "type": "string", "format": "uuid" },
